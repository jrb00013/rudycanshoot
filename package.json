{
  "name": "rudycanshoot",
  "version": "1.3.1",
  "description": "Screenshot tool with MCP server — lets AI assistants capture screens, windows, and terminals. Auto-installs into Claude Code, Cursor, Windsurf, Codex, Gemini CLI, OpenCode, and more.",
  "keywords": [
    "mcp",
    "screenshot",
    "ai",
    "claude",
    "cursor",
    "windsurf",
    "codex",
    "gemini",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/jrb00013/rudycanshoot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrb00013/rudycanshoot.git"
  },
  "bugs": {
    "url": "https://github.com/jrb00013/rudycanshoot/issues"
  },
  "license": "MIT",
  "author": "Joseph Black <jrb00013wvu@gmail.com>",
  "type": "module",
  "bin": {
    "rudycanshoot": "bin/rudycanshoot.js",
    "screenshot-mcp": "bin/screenshot-mcp.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/rudycanshoot.js serve",
    "install-tools": "node bin/rudycanshoot.js install --all",
    "test": "node --test tests/*.test.js",
    "lint": "node --check src/*.js bin/*.js 2>&1 || true",
    "prepublishOnly": "node --check bin/rudycanshoot.js && node --check src/server.js",
    "release": "bash scripts/publish.sh",
    "release:patch": "bash scripts/publish.sh patch",
    "release:minor": "bash scripts/publish.sh minor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
